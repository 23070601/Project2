# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5500

# --- Database (MySQL 8.0) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vnuis_asset_maintenance_dss

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Frontend (used in email notification links) ---
FRONTEND_BASE_URL=http://127.0.0.1:5500

# --- Email notifications (optional — web notifications still work without SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vnuis.edu.vn

